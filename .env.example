# Kopieer dit bestand buiten GitHub naar .env en vul eigen waarden in.
# Deel het ingevulde bestand en backups nooit via de repository.
DB_HOST=example.invalid
DB_PORT=3306
DB_NAME=nuts_v2
DB_USER=
DB_PASSWORD=
# Optioneel: alleen-lezen account voor de oude nuts-* databases tijdens import.
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
MQTT_HOST=example.invalid
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=sensors
# Leeg laten voor uitsluitend de vijf onderwerpen onder MQTT_PREFIX.
MQTT_COMPAT_PREFIX=
LOCAL_TIMEZONE=Europe/Amsterdam
P1_DEVICE=/dev/ttyUSB0
# Sla een geldig P1-telegram per 30 seconden op; de meter zelf blijft elke seconde sturen.
P1_CAPTURE_SECONDS=30
WATER_GPIO_BCM=17
# Host device for the 40-pin GPIO header; usually gpiochip0, older Pi 5 kernels may use gpiochip4.
GPIO_CHIP=/dev/gpiochip0
# Relative to this Compose project, so it also works under any /home/<user>/ path.
DATA_DIR=./data
P1_OUTBOX_PATH=/var/lib/nuts/p1.sqlite
WATER_OUTBOX_PATH=/var/lib/nuts/water.sqlite
CALC_LOOKBACK_DAYS=14
# Ruwe P1-, water- en PV-metingen blijven 90 Nederlandse kalenderdagen staan.
RAW_RETENTION_DAYS=90
COST_LOOKBACK_DAYS=35

# Alleen bereikbaar via localhost op de Pi of een SSH-tunnel.
TARIFF_ADMIN_USER=admin
TARIFF_ADMIN_PASSWORD=
TARIFF_WEB_PORT=8765

# Alleen-lezen notapagina op het Pi-adres; geen toegang tot tarievenbeheer.
# Vul desgewenst hier het LAN-adres van de Pi in in plaats van 0.0.0.0.
NOTA_DB_USER=
NOTA_DB_PASSWORD=
NOTA_WEB_BIND_ADDRESS=0.0.0.0
NOTA_WEB_PORT=8766

# GoodWe SEMS+ proef. Gebruik de bestaande SEMS+-login; niet de zakelijke OpenAPI.
GOODWE_STATION_ID=
GOODWE_ACCOUNT=
GOODWE_PASSWORD=
# Stel pas na vergelijking met SEMS+ in: kWh of MWh voor kale API-getallen.
GOODWE_TOTAL_UNIT=
GOODWE_POLL_SECONDS=60
PV_OUTBOX_PATH=/var/lib/nuts/pv.sqlite
